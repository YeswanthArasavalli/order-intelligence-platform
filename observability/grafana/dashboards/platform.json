{
  "uid": "oip-platform", "title": "Order Intelligence — Platform Overview", "schemaVersion": 39,
  "version": 1, "refresh": "10s", "timezone": "utc", "tags": ["oip", "M9"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Are scrape targets available?", "gridPos": {"x":0,"y":0,"w":8,"h":5}, "fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]}}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"up","legendFormat":"{{job}}","refId":"A"}]},
    {"id": 2, "type": "stat", "title": "Dependency health / serving readiness", "gridPos":{"x":8,"y":0,"w":16,"h":5}, "fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"-1":{"text":"UNKNOWN","color":"gray"},"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"},"2":{"text":"DEGRADED","color":"yellow"}}}]}}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"oip_dependency_state","legendFormat":"{{component}}","refId":"A"}]},
    {"id": 3, "type": "timeseries", "title": "Kafka producer: enqueued vs acknowledged events/s", "gridPos":{"x":0,"y":5,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"rate(oip_producer_events_total[5m])","legendFormat":"{{result}}","refId":"A"}]},
    {"id": 4, "type": "timeseries", "title": "Where is data flowing? Records/s", "gridPos":{"x":12,"y":5,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"rate(oip_bronze_records_total{result=\"written\"}[5m])","legendFormat":"Bronze written","refId":"A"},{"expr":"rate(oip_silver_records_total{route=\"accepted\"}[5m])","legendFormat":"Silver accepted","refId":"B"},{"expr":"rate(oip_gold_events_total{result=\"new\"}[5m])","legendFormat":"Gold new","refId":"C"}]},
    {"id": 5, "type": "timeseries", "title": "DQ failures and physical DLQ growth", "gridPos":{"x":0,"y":13,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"increase(oip_dq_records_total{result=\"failed\"}[5m])","legendFormat":"DQ failed","refId":"A"},{"expr":"increase(oip_dlq_records_written_total[5m])","legendFormat":"DLQ written","refId":"B"}]},
    {"id": 6, "type": "stat", "title": "Gold last observed / SQL / cache versions", "gridPos":{"x":12,"y":13,"w":12,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"oip_snapshot_version","legendFormat":"{{component}}","refId":"A"}]},
    {"id": 7, "type": "timeseries", "title": "Dashboard reads and fallback activity", "gridPos":{"x":0,"y":21,"w":8,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"sum by(source)(rate(oip_dashboard_loads_total[5m]))","legendFormat":"{{source}}","refId":"A"}]},
    {"id": 8, "type": "timeseries", "title": "M7 business-alert activity (observed results)", "gridPos":{"x":8,"y":21,"w":8,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"sum by(result)(increase(oip_alert_evaluations_total[5m]))","legendFormat":"{{result}}","refId":"A"}]},
    {"id": 9, "type": "timeseries", "title": "M8 notification delivery outcomes", "gridPos":{"x":16,"y":21,"w":8,"h":8}, "datasource":{"type":"prometheus","uid":"prometheus-oip"}, "targets":[{"expr":"increase(oip_notification_delivery_results_total[5m])","legendFormat":"{{result}}","refId":"A"}]},
    {"id":10,"type":"stat","title":"Telemetry loss / collector freshness — interpret zero activity with these", "gridPos":{"x":0,"y":29,"w":24,"h":5},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"oip_telemetry_dropped_updates_total","legendFormat":"reported drops","refId":"A"},{"expr":"time()-oip_exporter_collection_timestamp_seconds","legendFormat":"probe age seconds","refId":"B"}]},
    {"id":11,"type":"stat","title":"Instrumented Python process contact (one-shot jobs can be idle)","gridPos":{"x":0,"y":34,"w":12,"h":8},"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"-1":{"text":"UNKNOWN / IDLE","color":"gray"},"0":{"text":"LOST CONTACT","color":"red"},"1":{"text":"LIVE","color":"green"},"2":{"text":"LAST OP FAILED","color":"yellow"}}}]}},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"oip_application_state","legendFormat":"{{component}}","refId":"A"}]},
    {"id":12,"type":"stat","title":"Seconds since application telemetry (absent means never observed)","gridPos":{"x":12,"y":34,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"time()-oip_telemetry_last_received_timestamp_seconds","legendFormat":"{{component}}","refId":"A"}]}
  ]
}
