{
  "uid":"oip-serving-delivery","title":"Order Intelligence — Serving & Delivery","schemaVersion":39,"version":1,"refresh":"10s","timezone":"utc","tags":["oip","M9"],"time":{"from":"now-1h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Serving reachability versus metadata validity","gridPos":{"x":0,"y":0,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"oip_dependency_up{component=~\"postgres|redis\"}","legendFormat":"{{component}} reachable","refId":"A"},{"expr":"oip_snapshot_metadata_valid","legendFormat":"{{component}} metadata valid","refId":"B"}]},
    {"id":2,"type":"stat","title":"Snapshot age and SQL/cache agreement","gridPos":{"x":12,"y":0,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"time()-oip_snapshot_timestamp_seconds{component=~\"postgres|redis\"}","legendFormat":"{{component}} source age seconds","refId":"A"},{"expr":"oip_cache_matches_postgres","legendFormat":"identity matches","refId":"B"}]},
    {"id":3,"type":"timeseries","title":"Serving/refresh outcomes, including NOOP and failures","gridPos":{"x":0,"y":6,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_operation_calls_total{operation=~\"postgres_serve|postgres_commit|redis_refresh|redis_read\"}[5m])","legendFormat":"{{operation}} {{result}}","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"Dashboard source and reason for fallback","gridPos":{"x":12,"y":6,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_dashboard_loads_total[5m])","legendFormat":"{{source}} / {{redis_status}}","refId":"A"}]},
    {"id":5,"type":"timeseries","title":"M7 firings / cooldown suppression / NOOP / missing data","gridPos":{"x":0,"y":14,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_alert_evaluations_total[5m])","legendFormat":"{{result}}","refId":"A"}]},
    {"id":6,"type":"timeseries","title":"M8 logical requests versus attempt results","gridPos":{"x":12,"y":14,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_notification_requests_total[5m])","legendFormat":"requests {{result}}","refId":"A"},{"expr":"increase(oip_notification_attempt_results_total[5m])","legendFormat":"attempt {{result}}","refId":"B"}]},
    {"id":7,"type":"timeseries","title":"Retries / exhaustion / expired claims","gridPos":{"x":0,"y":22,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_notification_retries_total[5m])","legendFormat":"retries","refId":"A"},{"expr":"increase(oip_notification_exhausted_total[5m])","legendFormat":"exhausted","refId":"B"},{"expr":"increase(oip_notification_claims_total{result=\"recovered\"}[5m])","legendFormat":"expired claims recovered","refId":"C"}]},
    {"id":8,"type":"timeseries","title":"Controlled provider calls, acknowledgements and unique acceptances","gridPos":{"x":12,"y":22,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_provider_calls_total[5m])","legendFormat":"calls {{result}}","refId":"A"},{"expr":"increase(oip_provider_acceptances_total[5m])","legendFormat":"new acceptances","refId":"B"}]},
    {"id":9,"type":"timeseries","title":"Read/evaluate/provider p95 latency (seconds)","gridPos":{"x":0,"y":30,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"histogram_quantile(0.95,sum by(le,operation)(rate(oip_operation_duration_seconds_bucket{operation=~\"dashboard_load|alerts_evaluate|provider_send\"}[5m])))","legendFormat":"{{operation}}","refId":"A"}]}
  ]
}
