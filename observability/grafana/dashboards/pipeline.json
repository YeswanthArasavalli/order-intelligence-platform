{
  "uid":"oip-pipeline","title":"Order Intelligence — Data Pipeline","schemaVersion":39,"version":1,"refresh":"10s","timezone":"utc","tags":["oip","M9"],"time":{"from":"now-1h","to":"now"},
  "panels":[
    {"id":1,"type":"timeseries","title":"Bronze input/write rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"rate(oip_bronze_records_total[5m])","legendFormat":"{{result}}","refId":"A"}]},
    {"id":2,"type":"timeseries","title":"DQ outcomes and failure fraction (no samples stays absent)","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"rate(oip_dq_records_total[5m])","legendFormat":"{{result}} /s","refId":"A"},{"expr":"rate(oip_dq_records_total{result=\"failed\"}[5m])/ignoring(result) rate(oip_dq_records_total{result=\"evaluated\"}[5m])","legendFormat":"failure fraction","refId":"B"}]},
    {"id":3,"type":"timeseries","title":"Which existing DQ rules are failing?","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_dq_rule_failures_total[5m])","legendFormat":"{{rule}}","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"Silver accepted / rejected / replay activity","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"rate(oip_silver_records_total[5m])","legendFormat":"{{route}}","refId":"A"}]},
    {"id":5,"type":"timeseries","title":"Where are batches slow? p95 operation seconds","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"histogram_quantile(0.95,sum by(le,operation)(rate(oip_operation_duration_seconds_bucket{operation=~\"bronze_write|silver_write|dlq_write|gold_batch|gold_commit\"}[5m])))","legendFormat":"{{operation}}","refId":"A"}]},
    {"id":6,"type":"timeseries","title":"Processing/publication failures","gridPos":{"x":12,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"sum by(operation)(increase(oip_operation_calls_total{operation=~\"bronze_write|silver_write|dlq_write|gold_batch|gold_commit\",result=\"failure\"}[5m]))","legendFormat":"{{operation}}","refId":"A"}]},
    {"id":7,"type":"timeseries","title":"DLQ physical records and decoder invocation failures","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"increase(oip_dlq_records_written_total[5m])","legendFormat":"DLQ records","refId":"A"},{"expr":"increase(oip_decode_failures_total[5m])","legendFormat":"{{stage}} failures","refId":"B"}]},
    {"id":8,"type":"stat","title":"Last successful stage completion age (seconds)","gridPos":{"x":12,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus-oip"},"targets":[{"expr":"time()-oip_operation_last_success_timestamp_seconds{operation=~\"bronze_write|silver_write|gold_commit\"}","legendFormat":"{{operation}}","refId":"A"}]}
  ]
}
