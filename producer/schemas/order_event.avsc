{
  "namespace": "com.oip.orders",
  "type": "record",
  "name": "OrderEvent",
  "doc": "Order lifecycle event schema v1.0",
  "fields": [
    {"name": "order_id",       "type": "string"},
    {"name": "event_type",     "type": {"type": "enum", "name": "EventType",
      "symbols": ["ORDER_CREATED","ORDER_PAID","ORDER_SHIPPED","ORDER_DELIVERED","ORDER_CANCELLED","ORDER_REFUNDED"]}},
    {"name": "user_id",        "type": "string"},
    {"name": "product_id",     "type": "string"},
    {"name": "product_name",   "type": "string"},
    {"name": "region",         "type": "string"},
    {"name": "amount",         "type": "double"},
    {"name": "currency",       "type": "string",  "default": "INR"},
    {"name": "payment_method", "type": ["null","string"], "default": null},
    {"name": "status",         "type": "string"},
    {"name": "event_metadata", "type": ["null","string"], "default": null},
    {"name": "timestamp",      "type": "long", "logicalType": "timestamp-millis"},
    {"name": "schema_version", "type": "string", "default": "1.0"}
  ]
}
