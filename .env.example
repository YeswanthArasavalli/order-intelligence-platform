# =============================================================================
# Order Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in all required values before running.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED] have no default and MUST be set.
# Variables marked [DEFAULT] have a working default for local dev.
# =============================================================================


# -----------------------------------------------------------------------------
# KAFKA — KRaft mode
# -----------------------------------------------------------------------------

# [REQUIRED] Kafka cluster identity for KRaft mode.
# Generate ONCE with: make generate-cluster-id
# WARNING: Never regenerate this after the kafka-data volume has been created.
# If you must reset: make clean, then make generate-cluster-id, then make up.
KAFKA_CLUSTER_ID=

# [DEFAULT] Confluent Platform version — must be identical for kafka and schema-registry
KAFKA_VERSION=7.7.12

# [DEFAULT] Bootstrap servers (internal Docker network address)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Topic/prefix pairing used by Bronze and Silver; provision topics before startup.
KAFKA_TOPIC_ORDERS=order-events
KAFKA_TOPIC_DLQ=order-events-dlq

# [DEFAULT] External host port for producer/consumer connections from host machine
HOST_KAFKA_PORT=9092

# [DEFAULT] KRaft controller port (internal only)
HOST_KAFKA_CONTROLLER_PORT=29093


# -----------------------------------------------------------------------------
# SCHEMA REGISTRY
# -----------------------------------------------------------------------------

# [DEFAULT] Schema Registry URL (internal Docker network)
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# [DEFAULT] External host port for schema registration and inspection
HOST_SCHEMA_REGISTRY_PORT=8081

# [DEFAULT] Schema compatibility mode — BACKWARD enforces safe evolution
# Options: NONE, BACKWARD, BACKWARD_TRANSITIVE, FORWARD, FORWARD_TRANSITIVE, FULL, FULL_TRANSITIVE
SCHEMA_COMPATIBILITY_LEVEL=BACKWARD


# -----------------------------------------------------------------------------
# KAFKA UI
# -----------------------------------------------------------------------------

# [DEFAULT] Provectus Kafka UI version
KAFKA_UI_VERSION=v0.7.2

# [DEFAULT] External host port for Kafka UI web dashboard
HOST_KAFKA_UI_PORT=8080


# -----------------------------------------------------------------------------
# MINIO — S3-compatible local object storage
# -----------------------------------------------------------------------------

# [DEFAULT] MinIO server version
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z

# [DEFAULT] MinIO client (mc) version — used by minio-init container
MINIO_MC_VERSION=RELEASE.2024-11-05T11-29-45Z

# [DEFAULT] MinIO root credentials — change for any non-local environment
MINIO_ROOT_USER=minioadmin

# [REQUIRED] MinIO root password — must be at least 8 characters
MINIO_ROOT_PASSWORD=CHANGE_ME

# [DEFAULT] MinIO S3 API endpoint (internal Docker network)
MINIO_ENDPOINT=http://minio:9000

# [DEFAULT] MinIO S3 API external port
HOST_MINIO_API_PORT=9000

# [DEFAULT] MinIO web console external port
HOST_MINIO_CONSOLE_PORT=9001

# [DEFAULT] Data lake bucket names — do not change without updating Spark config
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold
MINIO_CHECKPOINT_BUCKET=checkpoints


# -----------------------------------------------------------------------------
# POSTGRESQL — Analytics store
# -----------------------------------------------------------------------------

# [DEFAULT] PostgreSQL version
POSTGRES_VERSION=16-alpine

# [DEFAULT] Database connection parameters (internal Docker network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=order_intelligence
POSTGRES_USER=oip_user

# [REQUIRED] PostgreSQL password — set a strong value for any shared environment
POSTGRES_PASSWORD=CHANGE_ME

# [DEFAULT] External host port — change if local Postgres is already running on 5432
HOST_POSTGRES_PORT=5432

# [DEFAULT] JDBC URL for Spark writer (used in Phase 8)
POSTGRES_JDBC_URL=jdbc:postgresql://postgres:5432/order_intelligence


# -----------------------------------------------------------------------------
# REDIS — Hot-path cache
# -----------------------------------------------------------------------------

# [DEFAULT] Redis version
REDIS_VERSION=7-alpine

# [DEFAULT] Redis connection (internal Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# [DEFAULT] Maximum memory Redis may use — increase for larger datasets
REDIS_MAX_MEMORY=256mb

# [DEFAULT] External host port — change if local Redis is already running on 6379
HOST_REDIS_PORT=6379

# [DEFAULT] TTL values (seconds) for Redis key families
REDIS_TTL_KPI=600
REDIS_TTL_LEADERBOARD=300
REDIS_TTL_ALERT=900
REDIS_TTL_DASHBOARD=60

# M5 PostgreSQL-derived analytical cache (legacy TTLs above do not apply).
# M5 uses the existing process environment, including POSTGRES_* credentials.
POSTGRES_GOLD_SCHEMA=gold_serving
REDIS_GOLD_NAMESPACE=oip:m5:gold-serving
REDIS_GOLD_MAX_ROWS=100000
REDIS_GOLD_MAX_BYTES=16777216
REDIS_DB=0
# Optional Redis ACL/auth for a separately configured server:
# REDIS_USERNAME=
# REDIS_PASSWORD=

# M6 dashboard: reads only gold_serving, preferring the M5 namespace above.
# Refresh is display polling only; it never writes or rebuilds the Redis cache.
DASHBOARD_REFRESH_SECONDS=10
# Empty means all currencies in separate views (no combined financial totals).
DASHBOARD_DEFAULT_CURRENCY=
# Optional expected source-topic pin; mismatching snapshots are rejected.
# Ignored in synthetic demo mode (a synthetic sample has no source topic).
DASHBOARD_SOURCE_TOPIC=
# Synthetic dashboard demo selector, read only by dashboard/app.py. Leave unset
# (or empty) for the real Redis/PostgreSQL sources; set exactly "synthetic" for
# the fixed in-memory sample (python -m dashboard.demo); set exactly "scripted"
# for the scripted synthetic replay, which steps through four predefined
# synthetic snapshots, advancing one snapshot every DASHBOARD_REFRESH_SECONDS
# (see dashboard/replay.py). Any other value is a configuration error and stops
# before real clients are constructed. Both synthetic modes are demo data only;
# neither reads or writes Redis or PostgreSQL.
# OIP_DEMO_MODE=synthetic
# OIP_DEMO_MODE=scripted


# -----------------------------------------------------------------------------
# PROMETHEUS
# -----------------------------------------------------------------------------

# [DEFAULT] Prometheus version
PROMETHEUS_VERSION=v2.54.1

# [DEFAULT] Metrics retention period
PROMETHEUS_RETENTION=15d

# [DEFAULT] External host port
HOST_PROMETHEUS_PORT=9090

# Legacy compatibility value; not consumed by the static Prometheus configuration.
# M9 uses 5s in observability/prometheus/prometheus.yml; edit that file to change it.
PROMETHEUS_SCRAPE_INTERVAL=15s

# M9 application telemetry is opt-in, best-effort and independent of business I/O.
# Set in each Python/Spark process to observe. Empty disables telemetry completely.
OIP_TELEMETRY_URL=
# Host example: http://127.0.0.1:8000/observe
# Compose-network example: http://metrics-exporter:8000/observe

# Exporter /metrics, /healthz and /readyz; Compose binds the host port to loopback.
HOST_METRICS_PORT=8000
METRICS_COLLECTION_INTERVAL_SECONDS=15
# Default is the retained local verification container. Point this at your actual
# Streamlit service. For host-run Streamlit on Docker Desktop, use
# http://host.docker.internal:8501/_stcore/health and a container-reachable bind.
OIP_DASHBOARD_HEALTH_URL=http://oip-modernization-verify:8501/_stcore/health
# Optional direct exporter process settings; Compose keeps internal port 8000:
# METRICS_BIND_ADDRESS=127.0.0.1
# METRICS_EXPORTER_PORT=8000


# -----------------------------------------------------------------------------
# GRAFANA
# -----------------------------------------------------------------------------

# [DEFAULT] Grafana version
GRAFANA_VERSION=11.3.0

# [DEFAULT] Admin credentials — change for any shared environment
GRAFANA_ADMIN_USER=admin

# [REQUIRED] Grafana admin password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# [DEFAULT] External host port
HOST_GRAFANA_PORT=3000


# -----------------------------------------------------------------------------
# SPARK — Used from Phase 4 onwards
# -----------------------------------------------------------------------------

# [DEFAULT] Spark master URL — local[*] uses all available CPU cores
SPARK_MASTER=local[*]

# [DEFAULT] Spark micro-batch trigger interval (seconds)
SPARK_TRIGGER_INTERVAL_SECONDS=30

# [DEFAULT] Checkpoint location — S3A path pointing at MinIO
SPARK_CHECKPOINT_DIR=s3a://checkpoints/streaming/

# [LEGACY] Retained for compatibility. M3 Gold uses revisable event-time snapshots,
# not watermark eviction; this setting is not consumed by Gold or Silver.
# Contracts: streaming/GOLD_CONTRACT.md and data_quality/CONTRACT.md.
SPARK_WATERMARK_MINUTES=2


# -----------------------------------------------------------------------------
# ALERTING — Used from Phase 10 onwards
# -----------------------------------------------------------------------------

# M7 authoritative PostgreSQL alerts (one-shot; no notifications).
# Supply a reviewed rule file explicitly; examples are not implicit business policy.
# ALERT_RULES_FILE=alerts/rules.example.json
ALERTS_SCHEMA=alerts_serving
# Optional exact source-topic pin. CLI analytical source is always gold_serving.
# ALERT_SOURCE_TOPIC=

# Legacy settings below are not consumed by the M7 evaluator.
# Alert cooldown in minutes — prevents duplicate alerts within this window
ALERT_COOLDOWN_MINUTES=15

# [OPTIONAL] Slack webhook URL — leave empty to disable Slack alerts
SLACK_WEBHOOK_URL=

# [OPTIONAL] PagerDuty integration key — leave empty to disable PagerDuty
PAGERDUTY_INTEGRATION_KEY=

# Revenue drop threshold — alert fires when current < BASELINE * threshold
ALERT_REVENUE_DROP_THRESHOLD=0.70

# Z-score threshold for statistical anomaly detection (Layer 2)
ALERT_ZSCORE_THRESHOLD=3.0

# M8 notifications: exactly one CONTROLLED/TEST HTTP provider, explicitly enabled.
# External messaging delivery is not certified by this local transport.
NOTIFICATIONS_SCHEMA=notifications_serving
NOTIFICATION_PROVIDER=
# Set to controlled_http for the local receiver.
NOTIFICATION_ENDPOINT=
# Explicit loopback endpoint format: http://127.0.0.1:<port>/notify
NOTIFICATION_DESTINATION=
# Use a logical test inbox alias, not a private address or credential.
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_BASE_DELAY_SECONDS=2
NOTIFICATION_MAX_DELAY_SECONDS=30
NOTIFICATION_TIMEOUT_SECONDS=2
NOTIFICATION_LEASE_SECONDS=30
